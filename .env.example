# Copia este archivo a ".env" y completa tus claves.
# Recuerda: lo que empieza por EXPO_PUBLIC_ queda dentro de la app (solo para el prototipo).

# IA de OpenRouter (lectura de la orden e identificación del medicamento)
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_MODEL=openrouter/free

# (Opcional) Búsqueda de imagen de referencia en Google Imágenes con enfoque Colombia
# (servicio Serper: https://serper.dev). Si se deja vacío se usa Wikimedia Commons (imagen genérica).
EXPO_PUBLIC_IMAGE_SEARCH_KEY=
