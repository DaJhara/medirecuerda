{
  "expo": {
    "name": "MediRecuerda",
    "slug": "medirecuerda",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medirecuerda.app"
    },
    "android": {
      "package": "com.medirecuerda.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MediRecuerda necesita la cámara para fotografiar tu orden médica.",
          "photosPermission": "MediRecuerda necesita acceso a tus fotos para leer tu orden médica."
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "medirecuerda",
    "extra": {
      "eas": {
        "projectId": "52837948-41a6-418f-9e3a-32d4ee7679bb"
      }
    }
  }
}
