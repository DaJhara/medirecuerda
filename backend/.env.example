# Copia a ".env" para desarrollo local. En Railway estas variables se definen en la pestaña "Variables".

NODE_ENV=development
# Railway define PORT solo; en local se usa 3000.
PORT=3000

# Railway: referencia el plugin de Postgres con ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medirecuerda
# "true" si la base exige SSL (URL pública de Railway). Con la URL interna (postgres.railway.internal) déjalo en false.
DATABASE_SSL=false

# Firma de las sesiones (JWT). Genera una larga y aleatoria: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Clave que debe enviar la app en el encabezado x-app-key (EXPO_PUBLIC_API_KEY de la app). Vacía = no se exige.
APP_API_KEY=

# Orígenes web permitidos (CORS), separados por coma. La app móvil no usa CORS. Vacío = ninguno.
CORS_ORIGINS=

# IA (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Búsqueda de imágenes (Serper, opcional; sin clave se usa Wikimedia)
SERPER_API_KEY=

# Google: Web client ID (el mismo EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID de la app). Necesario para POST /auth/google
GOOGLE_WEB_CLIENT_ID=

# Correo para "Olvidé mi contraseña" (Resend: https://resend.com). Sin clave, el código solo se escribe en los logs (solo pruebas).
RESEND_API_KEY=
MAIL_FROM=MediRecuerda <no-responder@tu-dominio.com>
